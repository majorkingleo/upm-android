<?xml version="1.0" encoding="utf-8"?>
<!--
  START modification - generated by AI (GitHub Copilot, DeepSeek V4 Flash)

  Custom content layout for the Preferences screen.

  PreferenceActivity normally inflates the framework's preference_list_content
  layout. With edge-to-edge enforced (targetSdk 36 on Android 15) that layout
  does not inset itself, so the whole preference list was drawn at y=0 behind
  the status bar and the framework ActionBar. The first category - Sync
  Settings with the Sync Method entry - was therefore invisible and could not be
  tapped, which made it impossible to switch sync methods. Every other screen in
  this app avoids the same problem with android:fitsSystemWindows="true" on its
  root layout; this layout follows that convention.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ListView android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:drawSelectorOnTop="false"/>

</LinearLayout>
<!-- END modification - generated by AI (GitHub Copilot, DeepSeek V4 Flash) -->
